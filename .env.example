# JARVIS — Beispielkonfiguration.
# Kopieren nach .env und ausfüllen. .env ist per .gitignore ausgeschlossen.
# Es gehören NIEMALS echte Schlüssel in diese Datei (Entwicklungsregel 2).

# ---- Kern ----
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_SECRET_KEY=                      # openssl rand -hex 32

# ---- Datenbank ----
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379/0

# ---- Anmeldung (ADR-007) ----
# Die Verankerung, die Passkeys phishing-resistent macht. Beide Werte gehören
# in die Konfiguration und NIEMALS in einen Request: Ein aus dem Request
# übernommener Origin hebt genau diese Eigenschaft auf.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=JARVIS
WEBAUTHN_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=jarvis_session

# Adressen, deren X-Forwarded-For geglaubt wird. Leer heißt: keinem — der
# sichere Standard. Ohne vorgeschalteten Proxy ist der Header ein frei
# erfundenes Feld, und ein Rate-Limit, das daran hängt, ist wirkungslos.
TRUSTED_PROXIES=

# ---- Secret-Verwaltung (ADR-008) ----
# file | keychain | vault
KEY_PROVIDER=file
KEY_PROVIDER_FILE_PATH=./secrets/kek.key

# ---- LLM-Anbieter ----
# Der lokale Pfad. Die Adresse ist nicht beliebig: models.py führt dieses
# Modell mit is_local=True, und daran macht das Model Gateway fest, dass P3 das
# Gerät nicht verlässt.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Fremde Anbieter. **Beides oder nichts** — ohne Schlüssel *und* Modellnamen
# entsteht kein Katalogeintrag. Ein Vorgabewert für den Namen steht hier
# bewusst nicht: Was es bei einem Anbieter gerade gibt, weiß diese Datei und
# nicht das Repository, und ein geratener Name scheitert erst nach der
# Modellwahl.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Anbieter, für die eine Zero-Retention-Vereinbarung **vorliegt**,
# kommagetrennt (z. B. anthropic,openai). Leer heißt: keine — dann sieht ein
# fremder Anbieter ausschließlich P0.
#
# Diese Zeile beschreibt einen Vertrag, sie misst ihn nicht. Wer hier etwas
# einträgt, ohne die Vereinbarung zu haben, hebt die Zusage auf, ohne dass eine
# Prüfung anschlägt. Höher als P1 kommt ein fremder Anbieter ohnehin nicht:
# P2 verlangt eine Freigabe je Domäne, die es nicht gibt, und P3 bleibt lokal.
CLOUD_ZERO_RETENTION=

# Preise in **Euro je einer Million Tokens**. Ohne sie entsteht kein
# Katalogeintrag — dritte Bedingung neben Schlüssel und Modellname, und
# dieselbe Frage aus einer weiteren Richtung: Ein Modell, dessen Kosten niemand
# kennt, macht aus der Kostengrenze eines Laufs eine Statistik.
#
# Sie stehen hier und nicht im Quelltext: Eine Preisliste im Repository ist
# beim nächsten Anbieterrundbrief falsch, und niemand merkt es. Wer
# Dollarpreise einträgt, misst in Dollar und nennt es Euro.
ANTHROPIC_COST_PER_1M_IN=
ANTHROPIC_COST_PER_1M_OUT=
OPENAI_COST_PER_1M_IN=
OPENAI_COST_PER_1M_OUT=

# Optional: eigener Preis für Tokens, die aus dem Prompt-Cache gelesen wurden.
# Ohne Angabe werden sie zum vollen Eingabepreis verbucht — die vorsichtige
# Richtung, denn zu früh anhalten ist ärgerlich und zu spät kostet Geld.
# ANTHROPIC_COST_PER_1M_CACHED_IN=
# OPENAI_COST_PER_1M_CACHED_IN=

# Fenster und Latenz gehen als Gewichte in die Modellwahl ein. Schätzwerte sind
# zulässig — das Routing ist deterministisch, nicht exakt. Ein zu großes
# Fenster ist die teurere Richtung: Es wählt ein Modell, das beim Anbieter
# abbricht.
# ANTHROPIC_CONTEXT_WINDOW=128000
# OPENAI_CONTEXT_WINDOW=128000

# ---- Budgets ----
# Je Lauf greift RunBudget (Tokens, Schritte, Zeit, Kosten, Werkzeugaufrufe);
# die Vorgaben stehen im Quelltext und sind nach Auslöser gestaffelt
# (docs/04-orchestrator.md §7). Über die Umgebung ist davon nichts einstellbar.
#
# Ein **Tagesbudget je Nutzer** beschreibt dasselbe Dokument — bei 80 % Warnung,
# bei 100 % nur noch lokale Modelle —, und es ist nicht gebaut: Es bräuchte
# einen Zähler über Läufe hinweg. Die Zeile JARVIS_DAILY_BUDGET_EUR stand hier
# und wurde von nichts gelesen; ein Schalter ohne Wirkung ist schlechter als
# keiner, weil er Sicherheit vortäuscht.

# ---- Integrationen (Phase 3) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
