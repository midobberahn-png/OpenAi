# JARVIS — Beispielkonfiguration.
# Kopieren nach .env und ausfüllen. .env ist per .gitignore ausgeschlossen.
# Es gehören NIEMALS echte Schlüssel in diese Datei (Entwicklungsregel 2).

# ---- Kern ----
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_SECRET_KEY=                      # openssl rand -hex 32

# ---- Datenbank ----
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379/0

# ---- Anmeldung (ADR-007) ----
# Die Verankerung, die Passkeys phishing-resistent macht. Beide Werte gehören
# in die Konfiguration und NIEMALS in einen Request: Ein aus dem Request
# übernommener Origin hebt genau diese Eigenschaft auf.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=JARVIS
WEBAUTHN_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=jarvis_session

# ---- Secret-Verwaltung (ADR-008) ----
# file | keychain | vault
KEY_PROVIDER=file
KEY_PROVIDER_FILE_PATH=./secrets/kek.key

# ---- LLM-Anbieter ----
# Leer lassen, was nicht genutzt wird — der Router überspringt fehlende Anbieter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_URL=http://localhost:11434

# Höchste Datenklasse je Anbieter (P0..P3). Wird NICHT vom Modell behauptet,
# sondern hier festgelegt. P3 gehört ausschließlich lokalen Modellen.
OPENAI_MAX_DATA_CLASS=P1
ANTHROPIC_MAX_DATA_CLASS=P1
GOOGLE_MAX_DATA_CLASS=P1
OLLAMA_MAX_DATA_CLASS=P3

# ---- Modelle ----
JARVIS_CLASSIFIER_MODEL=llama3.1:8b     # lokal, läuft bei jedem Turn
JARVIS_DEFAULT_MODEL=
JARVIS_LOCAL_FALLBACK_MODEL=llama3.1:8b

# ---- Budgets ----
JARVIS_DAILY_BUDGET_EUR=5.00

# ---- Integrationen (Phase 3) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
