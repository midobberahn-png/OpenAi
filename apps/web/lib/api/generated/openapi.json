{
  "components": {
    "schemas": {
      "AuthenticationRequest": {
        "properties": {
          "challenge": {
            "title": "Challenge",
            "type": "string"
          },
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          }
        },
        "required": [
          "credential",
          "challenge"
        ],
        "title": "AuthenticationRequest",
        "type": "object"
      },
      "BootstrapRequest": {
        "description": "Anlage des ersten Nutzers. Enthält bewusst keine ``user_id``.",
        "properties": {
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name"
        ],
        "title": "BootstrapRequest",
        "type": "object"
      },
      "CeremonyOptions": {
        "description": "Die Optionen für ``navigator.credentials`` — plus die Challenge.\n\nDie Challenge geht als base64url an den Client zurück und kommt beim\nAbschluss wieder mit. Sie ist **kein** Geheimnis: Ihr Wert liegt in der\nEinmaligkeit, nicht in der Verborgenheit.",
        "properties": {
          "challenge": {
            "title": "Challenge",
            "type": "string"
          },
          "options": {
            "additionalProperties": true,
            "title": "Options",
            "type": "object"
          }
        },
        "required": [
          "options",
          "challenge"
        ],
        "title": "CeremonyOptions",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RegistrationRequest": {
        "properties": {
          "challenge": {
            "title": "Challenge",
            "type": "string"
          },
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          },
          "device_label": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Label"
          }
        },
        "required": [
          "credential",
          "challenge"
        ],
        "title": "RegistrationRequest",
        "type": "object"
      },
      "SessionView": {
        "description": "Sitzungsübersicht für das Permission Center.",
        "properties": {
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "client": {
            "title": "Client",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_current": {
            "title": "Is Current",
            "type": "boolean"
          },
          "last_seen_at": {
            "title": "Last Seen At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "client",
          "channel",
          "created_at",
          "last_seen_at",
          "expires_at",
          "is_current"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Alle Endpunkte außer der Erstinbetriebnahme und dem Anmelde-Handshake verlangen eine gültige Sitzung. Die Identität stammt ausschließlich aus dieser Sitzung, nie aus Angaben im Request.",
    "summary": "Persönliches KI-Assistenzsystem",
    "title": "JARVIS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/bootstrap": {
      "post": {
        "description": "Legt den **ersten** Nutzer an und startet dessen Passkey-Registrierung.\n\nOhne diesen Weg wäre das System nicht in Betrieb zu nehmen: Registrieren\ndarf sonst nur, wer bereits angemeldet ist.\n\nDie Einmaligkeit trägt die Datenbank, nicht eine Prüfung davor. Der\n``INSERT`` läuft mit ``WHERE NOT EXISTS (SELECT 1 FROM users)`` — bei zwei\ngleichzeitigen Anfragen gewinnt genau eine. Ein vorgelagertes\n``SELECT count(*)`` wäre bei Nebenläufigkeit wertlos, und das Zeitfenster\ndieser Prüfung ist der Moment, in dem das System noch niemandem gehört.",
        "operationId": "bootstrap_auth_bootstrap_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyOptions"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bootstrap",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login/finish": {
      "post": {
        "description": "Prüft die Anmeldung und setzt das Sitzungscookie.",
        "operationId": "login_finish_auth_login_finish_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Login Finish Auth Login Finish Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login Finish",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login/start": {
      "post": {
        "description": "Challenge für die Anmeldung — ohne Nutzerangabe.\n\n``allow_credentials`` bleibt leer: Eine Liste zulässiger Schlüssel wäre\nein Verzeichnis. Der Authenticator wählt selbst, welcher Passkey zu dieser\nHerkunft passt.",
        "operationId": "login_start_auth_login_start_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyOptions"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Login Start",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Wer bin ich? Die Antwort stammt vollständig aus der Sitzung.",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Me Auth Me Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register/finish": {
      "post": {
        "description": "Schließt eine Registrierung ab.\n\nOhne Sitzungspflicht: Der Nutzer steckt in der Challenge, die beim Start\nausgestellt wurde — und die stammt entweder aus dem Bootstrap oder aus\neiner angemeldeten Sitzung. Eine zusätzliche Sitzungsprüfung hier würde\nden Bootstrap unmöglich machen, ohne etwas hinzuzufügen.",
        "operationId": "register_finish_auth_register_finish_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Register Finish Auth Register Finish Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register Finish",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register/start": {
      "post": {
        "description": "Startet die Registrierung eines weiteren Passkeys.\n\nDer Nutzer steht durch die Sitzung fest — es gibt keinen Parameter, mit\ndem er benannt werden könnte.",
        "operationId": "register_start_auth_register_start_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyOptions"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Register Start",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sessions": {
      "delete": {
        "description": "Alle Sitzungen beenden — der Knopf für den Geräteverlust.\n\nEr beendet auch die eigene: Wer ihn drückt, will überall abgemeldet sein,\nnicht überall außer hier.",
        "operationId": "revoke_all_auth_sessions_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "title": "Response Revoke All Auth Sessions Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Revoke All",
        "tags": [
          "auth"
        ]
      },
      "get": {
        "description": "Welche Geräte sind angemeldet — der Grund, warum Sitzungen in Postgres\nliegen (ADR-007, Nachtrag).",
        "operationId": "list_sessions_auth_sessions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionView"
                  },
                  "title": "Response List Sessions Auth Sessions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sessions",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sessions/{target_id}": {
      "delete": {
        "description": "Beendet eine Sitzung — nur eine eigene.\n\n``target_id`` ist eine Ressourcenkennung, keine Identität: Wem die Sitzung\ngehört, entscheidet der Abgleich mit den eigenen Sitzungen, nicht der Wert\nim Pfad. Ohne diesen Abgleich wäre der Endpunkt ein Fernabmelder für\nfremde Konten.",
        "operationId": "revoke_session_auth_sessions__target_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "target_id",
            "required": true,
            "schema": {
              "title": "Target Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Session",
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Erreichbarkeit. Bewusst ohne Datenbankzugriff und ohne Details —\nein Health-Endpunkt, der die Umgebung ausplaudert, ist eine\nAufklärungshilfe.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
