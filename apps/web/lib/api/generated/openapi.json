    "/auth/register/finish": {
      "post": {
        "description": "Schließt eine Registrierung ab.\n\nOhne Sitzungspflicht: Der Nutzer steckt in der Challenge, die beim Start\nausgestellt wurde — und die stammt entweder aus dem Bootstrap oder aus\neiner angemeldeten Sitzung. Eine zusätzliche Sitzungsprüfung hier würde\nden Bootstrap unmöglich machen, ohne etwas hinzuzufügen.",
        "operationId": "register_finish_auth_register_finish_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Register Finish Auth Register Finish Post",
                  "type": "object"
                }
              }
