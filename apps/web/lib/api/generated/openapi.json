  "info": {
    "description": "Alle Endpunkte außer der Erstinbetriebnahme und dem Anmelde-Handshake verlangen eine gültige Sitzung. Die Identität stammt ausschließlich aus dieser Sitzung, nie aus Angaben im Request.",
    "summary": "Persönliches KI-Assistenzsystem",
    "title": "JARVIS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actions": {
      "get": {
        "description": "Offene Bestätigungen des angemeldeten Nutzers.",
        "operationId": "list_actions_actions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ActionView"
                  },
                  "title": "Response List Actions Actions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Actions",
        "tags": [
          "approvals"
        ]
      }
    },
    "/actions/{action_id}/respond": {
      "post": {
        "description": "Erteilt oder verweigert eine Bestätigung — genau einmal.\n\nDie Einmaligkeit trägt die Datenbank (``burn()`` als bedingtes UPDATE),\nnicht diese Route. Zwei gleichzeitige „Ja\" ergeben eine Bestätigung und\neine Abweisung.\n\nEine Ablehnung ist kein Fehler: Sie ist eine gültige Antwort und endet mit\n200 und ``approved=false``. Ein 4xx hier würde die Entscheidung des\nMenschen als Störung führen.\n\nWas die Antwort **nicht** enthält, ist der sanierte Payload. Er entsteht\nim Gateway und ist die Eingabe der Ausführung, nicht Auskunft an den\nClient — der hat den Inhalt in der Vorschau bereits gesehen und\nbestätigt.",
        "operationId": "respond_action_actions__action_id__respond_post",
        "parameters": [
          {
            "in": "path",
            "name": "action_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Action Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespondRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespondResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Respond Action",
        "tags": [
          "approvals"
        ]
      }
    },
    "/auth/bootstrap": {
      "post": {
        "description": "Legt den **ersten** Nutzer an und startet dessen Passkey-Registrierung.\n\nOhne diesen Weg wäre das System nicht in Betrieb zu nehmen: Registrieren\ndarf sonst nur, wer bereits angemeldet ist.\n\nDie Einmaligkeit trägt die Datenbank, nicht eine Prüfung davor. Der\n``INSERT`` läuft mit ``WHERE NOT EXISTS (SELECT 1 FROM users)`` — bei zwei\ngleichzeitigen Anfragen gewinnt genau eine. Ein vorgelagertes\n``SELECT count(*)`` wäre bei Nebenläufigkeit wertlos, und das Zeitfenster\ndieser Prüfung ist der Moment, in dem das System noch niemandem gehört.",
        "operationId": "bootstrap_auth_bootstrap_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyOptions"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bootstrap",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login/finish": {
      "post": {
        "description": "Prüft die Anmeldung und setzt das Sitzungscookie.",
        "operationId": "login_finish_auth_login_finish_post",
